# Run the backend on the host. Copy to .env.local and fill external credentials.
# Export these variables before starting Go; the backend does not load dotenv itself.
# For Docker Compose, use infrastructure/env/local or infrastructure/env/prod instead.

# HTTP server (PORT is used by the healthcheck; keep it equal to SV_PORT).
SV_PORT=8080
PORT=8080
SV_WRITE_TIMEOUT=30s
SV_READ_TIMEOUT=30s
SV_IDLE_TIMEOUT=60s
SV_MAX_HEADER_BYTES=2
SV_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
SV_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Tenant-ID
SV_EXPOSE_HEADERS=Content-Length
SV_ALLOW_CREDENTIALS=true
SV_MAX_AGE=12h

# AI gRPC service
SVC_AI_HOST=localhost
SVC_AI_PORT=50051

# PostgreSQL
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=instay
SQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SQL_SSL_MODE=disable
SQL_DB_NAME=instay

# MongoDB (percent-encode credentials if included in this URI).
NOSQL_URI=mongodb://localhost:27017
NOSQL_DB_NAME=instay
NOSQL_MAX_POOL_SIZE=100
NOSQL_MIN_POOL_SIZE=0
NOSQL_MAX_CONN_IDLE_TIME=5m

# Redis
CA_HOST=localhost
CA_PORT=6379
CA_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
CA_USE_SSL=false

# Logging
LOG_LEVEL=info
LOG_ENCODING=json

# Tokens: generate separate random secrets, e.g. openssl rand -hex 32.
TK_ACCESS_NAME=access_token
TK_REFRESH_NAME=refresh_token
TK_GUEST_NAME=guest_token
TK_ACCESS_EXPIRES_IN=15m
TK_REFRESH_EXPIRES_IN=168h
TK_SECRET_KEY=REPLACE_WITH_RANDOM_TOKEN_SECRET
TK_API_KEY_SECRET=REPLACE_WITH_RANDOM_API_SECRET
TK_API_KEY_HEADER=X-API-Key
TK_API_KEY_PREFIX=Bearer

# Google Cloud Storage / Firebase: provide a valid development credential file.
# Never commit the credential JSON. This path is relative to the working directory.
GOOGLE_APPLICATION_CREDENTIALS=./configs/gcs.json
ST_BUCKET=REPLACE_WITH_GCS_BUCKET

# RabbitMQ
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=instay
MQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
MQ_VHOST=instay
MQ_USE_SSL=false

# SMTP
ML_HOST=REPLACE_WITH_SMTP_HOST
ML_PORT=587
ML_USER=REPLACE_WITH_SMTP_USER
ML_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# Optional KYC integration
KYC_ACCESS_TOKEN=
KYC_WORKFLOW_ID=
KYC_WEBHOOK_SECRET=
